{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Launch Dev Server",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev"],
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Launch Dev Server (Bun)",
			"runtimeExecutable": "bun",
			"runtimeArgs": ["--bun", "run", "dev"],
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Build and Deploy",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "build"],
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"],
			"postDebugTask": "deploy to firebase"
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Build and Deploy (Bun)",
			"runtimeExecutable": "bun",
			"runtimeArgs": ["--bun", "run", "build"],
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"],
			"postDebugTask": "deploy to firebase"
		},
		{
			"type": "firefox",
			"request": "launch",
			"name": "Debug in Firefox",
			"url": "http://localhost:5173",
			"webRoot": "${workspaceFolder}"
		},
		{
			"type": "chrome",
			"request": "launch",
			"name": "Debug in Chrome",
			"url": "http://localhost:5173",
			"webRoot": "${workspaceFolder}"
		}
	]
}
